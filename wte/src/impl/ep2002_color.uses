wte_cor         # o estado do editor de cor 2D (WTE-TASK-29)
wte_render2d    # PintaUmaAmostra, PreencheAmostras e os dois redesenhos
wte_uniformes   # FORMA_PADRAO -- o combo `lista_col0` a INDEXA
