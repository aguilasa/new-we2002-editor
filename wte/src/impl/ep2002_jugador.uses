# Unidades que os corpos de `impl/ep2002_jugador.*.inc` pedem, alem das que o
# gerador ja deduz dos componentes e das assinaturas.
SysUtils       # IntToStr, Copy
Classes        # TComponent
Controls       # TControl.Width
ComCtrls       # TUpDown.Position
StdCtrls       # TLabel.Caption
wte_legendas   # Legenda, LegendaDoCabelo -- gerado por tools/dump_legendas.py
Graphics       # TColor
retrace        # REMark
we2002_estado  # TimeEmEdicao, JogadorEmEdicao, JogadorTemCampoCondicional
we2002_player  # TPlayer -- as 28 caixas de bit do BitBtn3Click
wte_ficha      # BufferJogador, GravaJogador, GravaNumeroDaCamisa (CORR-WTE-081)
ep2002_error2  # ficha_error2.etiq1, nas duas recusas do BitBtn3Click
we2002_preco   # PrecoDaSoma, POSICAO_GOLEIRO, FATOR_DE_EXIBICAO (WTE-TASK-32)
