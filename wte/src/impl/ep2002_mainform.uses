# Unidades que os corpos de `impl/ep2002_mainform.*.inc` pedem, alem das que o
# gerador ja deduz dos componentes e das assinaturas.
SysUtils        # ExtractFileName
we2002_estado   # AbreImagem, CaminhoDatBin, Jogo
wtemain         # ImagemDaLinhaDeComando
retrace        # REMark
we2002_database  # ResolveMlLink
we2002_types     # SquadNumberAt
we2002_player    # TPlayer, no PreencheFicha
StdCtrls         # TComboBox nos auxiliares
ep2002_jugador   # jugador.ShowModal
ep2002_estrategia # estrategia.ShowModal
ep2002_dorsal   # ficha_dorsal.ShowModal, no dorsalClick
ep2002_error    # ficha_error.etiq1, no MostraCodigo
ep2002_error2   # ficha_error2.etiq1, no pabajoClick
ep2002_movertodos # ficha_movertodos.ShowModal, nos dois botoes de lote
Controls        # mrYes
wte_legendas   # Legenda, LegendaDoCabelo -- gerado por tools/dump_legendas.py
we2002_tables    # TEAM_NAME_LEN_3, no LimiteDoNome2 (CORR-WTE-061)
ep2002_info3    # ficha_info3.etiq1 + ShowModal, no boton_barras2isoClick
we2002_offsets  # TOffset, no endereco de gravacao
we2002_cdimage  # TCdImage, na varredura dos blocos de nome
Classes         # TFileStream, na copia da textura
we2002_ml       # ContaBlocosLivresDeMl -- a 0x004042d4 (WTE-TASK-33)
ep2002_info4    # ficha_info4.etiq3, no aviso de bloco compartilhado
we2002_mcr      # o layout do .mcr e o leitor de cartao (WTE-TASK-28)
we2002_render   # TCoresDoTime e as constantes de paleta (WTE-TASK-29)
wte_render2d    # DesenhaBandeira, DesenhaUniforme -- o render 2D (WTE-TASK-29)
wte_cor        # TimeEmCor, o time que o editor de cor edita (WTE-TASK-29)
ep2002_color   # ficha_color.ShowModal, no colorearClick (WTE-TASK-29)
ep2002_about    # ficha_about.ShowModal, no SpeedButton1Click (WTE-TASK-30)
ep2002_salida   # ficha_salida.ShowModal, no SpeedButton2Click (WTE-TASK-30)
LCLIntf         # OpenURL, no Image3Click (WTE-TASK-30)
ep2002_creditos_equipo # ficha_creditos_equipo.ShowModal, no base_teamClick (WTE-TASK-30)
wte_ficha       # o buffer de jogador e a gravacao de jogador (CORR-WTE-081)
wte_tatica      # a carga e o preenchimento da tela de tatica (CORR-WTE-082)
