# Unidades que os corpos de `impl/ep2002_mainform.*.inc` pedem, alem das que o
# gerador ja deduz dos componentes e das assinaturas.
SysUtils        # ExtractFileName
we2002_estado   # AbreImagem, CaminhoDatBin, Jogo
wtemain         # ImagemDaLinhaDeComando
retrace        # REMark
we2002_database  # ResolveMlLink
we2002_types     # SquadNumberAt
StdCtrls         # TComboBox nos auxiliares
ep2002_jugador   # jugador.ShowModal
ep2002_estrategia # estrategia.ShowModal
ep2002_dorsal   # ficha_dorsal.ShowModal, no dorsalClick
ep2002_error    # ficha_error.etiq1, no MostraCodigo
ep2002_movertodos # ficha_movertodos.ShowModal, nos dois botoes de lote
Controls        # mrYes
