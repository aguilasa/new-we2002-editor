<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata, so a software centre or an appstream-indexing package
     format has something to read. It describes the application; it grants
     nothing.

     project_license is LicenseRef-proprietary and not an SPDX identifier on
     purpose: no prior author licensed this code, so it is all rights reserved.
     See NOTICE.md. Do not "fix" this to MIT or GPL. That would be claiming a
     grant nobody made.

     No double hyphen anywhere in here: XML forbids it inside a comment, and
     appstreamcli rejects the whole file rather than skipping the comment. The
     same trap caught tools/rc2ui.py in phase 4. -->
<component type="desktop-application">
  <id>io.github.aguilasa.newWe2002</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <name>WE2002 Editor</name>
  <summary>Edit a Winning Eleven 2002 CD image</summary>

  <description>
    <p>
      Edits teams, players, tactics, kits and flags directly inside a Winning
      Eleven 2002 (PlayStation) CD image. Changes are written into the raw
      .bin in place.
    </p>
    <p>
      A port of the 2002 MFC tool "we2002 mania editor" by Francesco Moriero,
      with the SoFIFA import added later by thyddralisk. The port is verified
      byte for byte against the original binary running under Wine.
    </p>
    <p>
      No game data is included. The image must be a raw MODE2/2352 dump; a file
      extracted from the ISO9660 filesystem will not work. Always work on a
      copy.
    </p>
  </description>

  <!-- The account that publishes the port. The lineage of the code it is a
       port of is in the description and in NOTICE.md. -->
  <developer id="io.github.aguilasa">
    <name>aguilasa</name>
  </developer>

  <launchable type="desktop-id">io.github.aguilasa.newWe2002.desktop</launchable>
  <url type="homepage">https://github.com/aguilasa/new-we2002-editor</url>
  <url type="bugtracker">https://github.com/aguilasa/new-we2002-editor/issues</url>

  <categories>
    <category>Game</category>
  </categories>

  <provides>
    <binary>newWe2002</binary>
  </provides>

  <content_rating type="oars-1.1"/>
</component>
